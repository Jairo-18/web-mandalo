---
type Props = {
  title: string;
  description?: string;
};

const { title, description = 'Mándalo — LO PIDES, LO LLEVAMOS.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Mándalo</title>
  </head>
  <body>
    <div class="page">
      <header class="brand-header">
        <a href="/" class="brand-link">
          <span class="brand-name">Mándalo</span>
          <span class="brand-slogan">LO PIDES, LO LLEVAMOS.</span>
        </a>
      </header>

      <main class="content">
        <slot />
      </main>

      <footer class="brand-footer">
        <nav class="footer-nav">
          <a href="/politicas-de-privacidad">Política de privacidad</a>
          <a href="/terminos-y-condiciones-de-uso">Términos y condiciones</a>
          <a href="/eliminar-cuenta">Eliminar mi cuenta</a>
        </nav>
        <p>© {new Date().getFullYear()} Mándalo — Villagarzón, Putumayo, Colombia</p>
      </footer>
    </div>

    <style is:global>
      :root {
        --primary: #ff5a3c;
        --primary-soft: #ff8c6e;
        --primary-tint: #ffe7e1;
        --dark: #1e1e2d;
        --muted: #7a7a8a;
        --surface: #f2f2f2;
        --white: #ffffff;
        --red: #dc2626;
        --red-tint: #fef2f2;
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--surface);
        color: var(--dark);
        font-family:
          'Helvetica Neue',
          Arial,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .brand-header {
        background: linear-gradient(135deg, var(--white), var(--primary-soft), var(--primary));
        padding: 28px 20px 40px;
      }

      .brand-link {
        text-decoration: none;
        display: block;
        text-align: center;
      }

      .brand-name {
        display: block;
        color: var(--dark);
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .brand-slogan {
        display: block;
        color: var(--dark);
        opacity: 0.7;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.15em;
        margin-top: 4px;
      }

      .content {
        flex: 1;
        width: 100%;
        max-width: 640px;
        margin: -20px auto 0;
        padding: 0 20px 48px;
      }

      .card {
        background: var(--white);
        border-radius: 20px;
        padding: 32px 28px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }

      h1 {
        font-size: 22px;
        font-weight: 800;
        color: var(--dark);
        margin: 0 0 8px;
      }

      h2 {
        font-size: 16px;
        font-weight: 800;
        color: var(--dark);
        margin: 24px 0 6px;
      }

      p {
        font-size: 15px;
        line-height: 1.6;
        color: var(--muted);
        margin: 0 0 12px;
      }

      a {
        color: var(--primary);
      }

      .brand-footer {
        text-align: center;
        padding: 24px 20px 40px;
      }

      .footer-nav {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px 18px;
        margin-bottom: 12px;
      }

      .footer-nav a {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
      }

      .footer-nav a:hover {
        color: var(--primary);
      }

      .brand-footer p {
        font-size: 12px;
        color: var(--muted);
        margin: 0;
      }
    </style>
  </body>
</html>
